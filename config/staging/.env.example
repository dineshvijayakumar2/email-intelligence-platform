# Staging Environment Configuration Template
# Similar to production but with different endpoints and relaxed limits

ENVIRONMENT=staging
DEBUG=true
LOG_LEVEL=debug

# Database (Staging Supabase Project)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_KEY=your-staging-service-key

# Redis (Railway Staging)
REDIS_URL=redis://redis.railway.internal:6379
REDIS_TTL_DAYS=7

# Google Drive API (Same OAuth app, different redirect)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://staging.emailintel.app/auth/google/callback

# Multi-tenant (Testing mode)
ENABLE_MULTI_TENANT=true
DEFAULT_TENANT_PLAN=trial
MAX_FREE_MAILBOXES=5

# Worker (Reduced concurrency)
WORKER_CONCURRENCY=2
MAX_EMAILS_PER_BATCH=50
PROCESSING_TIMEOUT=1800

# API Configuration
API_BASE_URL=https://api-staging.emailintel.app
FRONTEND_URL=https://staging.emailintel.app
CORS_ORIGINS=https://staging.emailintel.app,http://localhost:3000

# Security (Different keys from production)
JWT_SECRET_KEY=staging-jwt-secret-key-for-testing
ENCRYPTION_KEY=staging-encryption-key-base64

# Feature Flags (More features enabled for testing)
ENABLE_AI_CATEGORIZATION=true
ENABLE_DEBUG_ENDPOINTS=true