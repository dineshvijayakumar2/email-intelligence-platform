# Production Environment Configuration Template
# Copy this to .env and fill in your actual values
# DO NOT commit .env files to version control

# ============================================
# CORE CONFIGURATION
# ============================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# ============================================
# DATABASE (Supabase)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# ============================================
# CACHE (Redis)
# ============================================
REDIS_URL=redis://default:password@redis.railway.internal:6379
REDIS_TTL_DAYS=30
REDIS_MAX_CONNECTIONS=50

# ============================================
# GOOGLE DRIVE API
# ============================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://app.emailintel.app/auth/google/callback
GOOGLE_SERVICE_ACCOUNT_KEY=base64-encoded-json-key

# ============================================
# MULTI-TENANT CONFIGURATION
# ============================================
ENABLE_MULTI_TENANT=true
DEFAULT_TENANT_PLAN=starter
MAX_FREE_MAILBOXES=3
TENANT_ISOLATION_MODE=row_level_security

# ============================================
# WORKER CONFIGURATION
# ============================================
WORKER_CONCURRENCY=4
MAX_EMAILS_PER_BATCH=100
PROCESSING_TIMEOUT=3600
WORKER_QUEUE_NAME=email_processing
MAX_RETRIES=3

# ============================================
# API CONFIGURATION
# ============================================
API_BASE_URL=https://api.emailintel.app
FRONTEND_URL=https://app.emailintel.app
CORS_ORIGINS=https://app.emailintel.app,https://*.emailintel.app
API_RATE_LIMIT=1000/hour
API_KEY_HEADER=X-API-Key

# ============================================
# SECURITY
# ============================================
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=your-encryption-key-base64
ALLOWED_HOSTS=.emailintel.app,.railway.app

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN=https://your-key@sentry.io/project-id
DATADOG_API_KEY=your-datadog-api-key
ENABLE_METRICS=true
ENABLE_TRACING=true

# ============================================
# EMAIL PROCESSING
# ============================================
MAX_EMAIL_SIZE_MB=25
MAX_ATTACHMENT_SIZE_MB=10
SUPPORTED_FORMATS=mbox,pst,olm
ENABLE_VIRUS_SCAN=true
ENABLE_SPAM_DETECTION=true

# ============================================
# STORAGE
# ============================================
STORAGE_BACKEND=supabase
MAX_STORAGE_PER_TENANT_GB=100
ENABLE_COMPRESSION=true
ENABLE_DEDUPLICATION=true

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_OAUTH2=true
ENABLE_WEBHOOK_NOTIFICATIONS=true
ENABLE_EMAIL_TAGGING=true
ENABLE_AI_CATEGORIZATION=false
ENABLE_ADVANCED_SEARCH=true