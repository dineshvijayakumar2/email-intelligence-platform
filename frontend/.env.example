# Frontend Environment Configuration Template
# Copy this file to .env.development or .env.production and fill in your values

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api  # Development
# VITE_API_BASE_URL=https://${{backend.RAILWAY_PRIVATE_DOMAIN}}/api  # Production

# Supabase Configuration (Required for Authentication)
# Get these from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Google Drive & Gmail Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback  # Development
# VITE_GOOGLE_REDIRECT_URI=https://${{frontend.RAILWAY_PRIVATE_DOMAIN}}/auth/google/callback  # Production

# Microsoft Outlook/O365 Configuration
# Create an app at https://portal.azure.com > App registrations
# Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
# Platform: Single-page application (SPA)
VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id
VITE_MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback  # Development
# VITE_MICROSOFT_REDIRECT_URI=https://${{frontend.RAILWAY_PRIVATE_DOMAIN}}/auth/microsoft/callback  # Production

# Environment
NODE_ENV=development  # or production