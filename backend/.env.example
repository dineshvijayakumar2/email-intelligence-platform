# Backend Environment Configuration Template
# Copy this file to .env.development or .env.production and fill in your values

# ─── Supabase Configuration ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here
# JWT Secret for verifying Supabase Auth tokens (Dashboard > Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your_jwt_secret_here

# ─── Redis Configuration (Required for job processing) ───────────────────────
REDIS_URL=redis://localhost:6379  # Development
# REDIS_URL=${Redis.REDIS_URL}    # Production (Railway)
REDIS_TTL_DAYS=7
# Alternative Redis config (used if REDIS_URL not set)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ─── Google OAuth & Drive ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback  # Development
# GOOGLE_REDIRECT_URI=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}/auth/google/callback  # Production
# GOOGLE_REDIRECT_URI_OVERRIDE=postmessage  # Override for popup-based OAuth flow

# Google Service Account (optional — for server-side Drive access)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Microsoft / Azure AD (Outlook LIVE sync) ───────────────────────────────
# Create an app at https://portal.azure.com > App registrations
# Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
# Platform: Single-page application (SPA)
# Required API permissions: Mail.Read, User.Read, MailboxSettings.Read
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common  # Use 'common' for both O365 and personal accounts
# Azure-specific aliases (used by Outlook Live extractor)
# AZURE_CLIENT_ID=your_microsoft_client_id
# AZURE_CLIENT_SECRET=your_microsoft_client_secret
# AZURE_TENANT_ID=common
# AZURE_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback

# ─── Sync Intervals ─────────────────────────────────────────────────────────
GMAIL_SYNC_INTERVAL_MINUTES=15     # Default: 15 (min: 1, max: 1440)
OUTLOOK_SYNC_INTERVAL_MINUTES=15   # Default: 15 (min: 1, max: 1440)
# GMAIL_SYNC_API_KEY=optional_api_key_for_cron_endpoint
# OUTLOOK_SYNC_API_KEY=optional_api_key_for_cron_endpoint

# ─── AI / LLM Configuration ─────────────────────────────────────────────────
# Anthropic Claude (primary AI — classification, digests, strategic analysis)
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (fallback AI + embeddings)
# Get your key at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
# Alternative key names (any one works):
# GOOGLE_API_KEY=your_gemini_api_key_here
# GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (optional — for embeddings and LLM fallback)
# Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# AI Model Selection (defaults work well — only change if needed)
# AI_CHEAP_MODEL=haiku       # Fast/cheap: haiku, gemini, gpt-4o-mini
# AI_STRATEGIC_MODEL=sonnet  # Strategic: sonnet, gpt-4o

# ─── Embedding Provider ─────────────────────────────────────────────────────
# "google" (default) = gemini-embedding-001, "openai" = text-embedding-3-small
# Both produce 768-dim vectors compatible with pgvector schema
EMBEDDING_PROVIDER=google
# Set to "openai" + OPENAI_API_KEY if Google hits 503 UNAVAILABLE errors

# ─── API Configuration ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your_secret_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3001  # Development (comma-separated for multiple)
# ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}  # Production (Railway)

# ─── Development Flags ───────────────────────────────────────────────────────
# USE_PROD_DB=false          # Set to "true" to use production Supabase locally
# DOWNLOAD_DIR=/data/downloads  # File download directory (default: None in dev)

# Environment
NODE_ENV=development  # or production
PYTHON_ENV=development  # or production
