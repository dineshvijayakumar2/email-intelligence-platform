# Backend Environment Configuration Template
# Copy this file to .env.development or .env.production and fill in your values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here
# JWT Secret for verifying Supabase Auth tokens (Dashboard → Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Redis Configuration (Required for job processing)
REDIS_URL=redis://localhost:6379  # Development
# REDIS_URL=${Redis.REDIS_URL}    # Production (Railway)
REDIS_TTL_DAYS=7

# Google Drive API Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback  # Development
# GOOGLE_REDIRECT_URI=https://${{frontend.RAILWAY_PRIVATE_DOMAIN}}/auth/google/callback  # Production

# Microsoft Identity Platform Configuration (Azure AD - for Outlook LIVE sync)
# Create an app registration at https://portal.azure.com > App registrations
# Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
# Platform: Single-page application (SPA)
# Required API permissions: Mail.Read, User.Read, MailboxSettings.Read
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common  # Use 'common' for both O365 and personal accounts

# Outlook Sync Configuration
OUTLOOK_SYNC_INTERVAL_MINUTES=15  # Default: 15 minutes (min: 1, max: 1440)
# OUTLOOK_SYNC_API_KEY=optional_api_key_for_cron_endpoint

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your_secret_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000  # Development (comma-separated for multiple)
# ALLOWED_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}  # Production (Railway)

# Environment
NODE_ENV=development  # or production
PYTHON_ENV=development  # or production